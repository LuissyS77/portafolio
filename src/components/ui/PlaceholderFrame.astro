---
interface Props {
  aspectRatio: string;
  alt: string;
  tilt?: boolean;
  /** URL de Cloudinary (u otra) — si se pasa, se muestra la imagen real en vez del marco rayado. */
  src?: string;
  /** "cover" (default) llena el marco recortando; "contain" muestra la imagen completa. */
  fit?: "cover" | "contain";
}

const { aspectRatio, alt, tilt = false, src, fit = "cover" } = Astro.props;
---

<div class:list={["placeholder-frame", { "placeholder-frame--filled": !!src }]} style={`aspect-ratio:${aspectRatio}`} data-tilt={tilt ? "" : undefined}>
  {src ? (
    <img class="placeholder-frame__img" style={`object-fit:${fit}`} src={src} alt={alt} loading="lazy" decoding="async" />
  ) : (
    <span class="placeholder-frame__label">[ {alt} ]</span>
  )}
</div>

<style>
  .placeholder-frame[data-tilt] {
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .placeholder-frame--filled {
    padding: 0;
    background-image: none;
    background-color: rgba(var(--fg-rgb), 0.03);
    overflow: hidden;
  }
  .placeholder-frame__img {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
