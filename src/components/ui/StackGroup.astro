---
interface Props {
  categoria: string;
  items: string[];
}

const { categoria, items } = Astro.props;
---

<div class="stack-group" data-reveal>
  <div class="stack-group__title">{categoria}</div>
  <div class="stack-group__items">
    {items.map((item) => <span class="stack-group__chip">{item}</span>)}
  </div>
</div>

<style>
  .stack-group {
    opacity: 0;
    transform: translateY(22px);
  }
  .stack-group__title {
    font-family: var(--font-serif);
    font-size: 26px;
    margin-bottom: 14px;
  }
  .stack-group__items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .stack-group__chip {
    padding: 9px 14px;
    background: rgba(var(--fg-rgb), 0.06);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    white-space: nowrap;
    color: rgba(var(--fg-rgb), 0.8);
  }
</style>
