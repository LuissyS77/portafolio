---
import { marqueeItems } from "../../data/site";
---

<div class="marquee">
  <div class="marquee__track">
    {[...marqueeItems, ...marqueeItems].map((item) => (
      <>
        <span>{item}</span><span>·</span>
      </>
    ))}
  </div>
</div>

<style>
  .marquee {
    border-top: 1px solid rgba(var(--fg-rgb), 0.1);
    border-bottom: 1px solid rgba(var(--fg-rgb), 0.1);
    padding: 16px 0;
    overflow: hidden;
    white-space: nowrap;
  }
  .marquee__track {
    display: inline-flex;
    gap: 36px;
    animation: marq 28s linear infinite;
    font-family: var(--font-serif);
    font-size: 34px;
    color: rgba(var(--fg-rgb), 0.28);
  }
</style>
