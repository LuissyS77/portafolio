---
import ButtonPill from "../ui/ButtonPill.astro";
import { site } from "../../data/site";
---

<header id="top" class="hero">
  <div class="hero__grid" data-parallax aria-hidden="true"></div>
  <div class="hero__blob hero__blob--a" data-parallax aria-hidden="true"></div>
  <div class="hero__blob hero__blob--b" data-parallax aria-hidden="true"></div>
  <div class="hero__stars" data-stars data-parallax aria-hidden="true"></div>
  <div class="hero__vignette" data-parallax aria-hidden="true"></div>

  <div class="hero__topline">
    <span>Portafolio {site.anioCopyright}</span>
    <span>{site.ubicacion} · <span data-clock></span></span>
    <span class="hero__topline-right">{site.rol}</span>
  </div>

  <div class="hero__center">
    {site.disponible && (
      <div class="hero__badge" data-reveal>
        <span class="hero__badge-dot" aria-hidden="true"></span>Abierto a oportunidades
      </div>
    )}
    <div>
      <div class="hero__kicker" data-reveal>Hola, soy</div>
      <h1 class="hero__title">
        <span class="hero__title-mask"><span data-rise class="hero__title-line">Luissy</span></span>
        <span class="hero__title-mask"><span data-rise class="hero__title-line"><em class="hero__title-em">Angulo</em></span></span>
      </h1>
    </div>
    <div class="hero__role" data-reveal>
      <span class="hero__role-caret-lead">&gt;</span><span data-rotating></span><span class="hero__role-caret" aria-hidden="true"></span>
    </div>
    <div class="hero__ctas" data-reveal>
      <ButtonPill href="#proyectos" variant="fill">Ver proyectos <span>→</span></ButtonPill>
      <ButtonPill href="#contacto" variant="outline">Contacto</ButtonPill>
    </div>
  </div>

  <div class="hero__bottomline">
    <span class="hero__scrollcue">
      <span class="hero__scrollcue-track" aria-hidden="true"><span class="hero__scrollcue-bead"></span></span>
      Desplázate
    </span>
    <span>01 — 06</span>
  </div>
</header>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
    padding: 88px 30px 24px;
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: -3;
    background-image: linear-gradient(rgba(var(--fg-rgb), 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--fg-rgb), 0.055) 1px, transparent 1px);
    background-size: 64px 64px;
    animation: gridpan 22s linear infinite;
    -webkit-mask-image: radial-gradient(ellipse 78% 62% at 50% 46%, #000 0%, transparent 78%);
    mask-image: radial-gradient(ellipse 78% 62% at 50% 46%, #000 0%, transparent 78%);
  }
  .hero__blob {
    position: absolute;
    z-index: -2;
    border-radius: 50%;
    filter: blur(52px);
  }
  .hero__blob--a {
    top: -18%;
    left: 14%;
    width: 62vw;
    height: 62vw;
    max-width: 900px;
    max-height: 900px;
    background: radial-gradient(circle, rgba(var(--fg-rgb), 0.16) 0%, rgba(var(--fg-rgb), 0.05) 42%, transparent 68%);
    animation: drift 26s ease-in-out infinite;
  }
  .hero__blob--b {
    bottom: -22%;
    right: 8%;
    width: 52vw;
    height: 52vw;
    max-width: 760px;
    max-height: 760px;
    background: radial-gradient(circle, rgba(168, 159, 141, 0.2) 0%, rgba(168, 159, 141, 0.06) 45%, transparent 70%);
    filter: blur(64px);
    animation: drift2 32s ease-in-out infinite;
  }
  .hero__stars {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
  }
  .hero__vignette {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse 70% 55% at 50% 50%, transparent 30%, rgba(12, 12, 11, 0.55) 78%, var(--bg) 100%);
  }

  .hero__topline,
  .hero__bottomline {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-family: var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(var(--fg-rgb), 0.4);
  }
  .hero__topline {
    font-size: 10.5px;
    padding-top: 18px;
  }
  .hero__topline-right {
    text-align: right;
  }
  .hero__bottomline {
    align-items: flex-end;
    margin-top: 20px;
    font-size: 10px;
  }

  .hero__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 30px;
    padding: 20px 0;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 18px;
    border: 1px solid rgba(var(--fg-rgb), 0.18);
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(var(--fg-rgb), 0.72);
    opacity: 0;
    transform: translateY(14px);
  }
  .hero__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--status-green);
    animation: blink 2.6s infinite;
  }

  .hero__kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(var(--fg-rgb), 0.45);
    margin-bottom: 18px;
    opacity: 0;
    transform: translateY(14px);
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(66px, 12vw, 178px);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .hero__title-mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.2em;
    margin-bottom: -0.2em;
  }
  .hero__title-line {
    display: block;
    transform: translateY(125%);
    transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero__title-em {
    font-style: italic;
    color: var(--accent-italic);
  }

  .hero__role {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: clamp(13px, 1.4vw, 17px);
    letter-spacing: 0.08em;
    color: rgba(var(--fg-rgb), 0.72);
    border: 1px solid rgba(var(--fg-rgb), 0.16);
    border-radius: 100px;
    padding: 12px 24px;
    min-height: 46px;
    opacity: 0;
    transform: translateY(14px);
  }
  .hero__role-caret-lead {
    color: rgba(var(--fg-rgb), 0.4);
  }
  .hero__role-caret {
    width: 9px;
    height: 18px;
    background: var(--fg);
    animation: caret 1s steps(1) infinite;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 6px;
    opacity: 0;
    transform: translateY(14px);
  }

  .hero__scrollcue {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .hero__scrollcue-track {
    display: block;
    width: 1px;
    height: 44px;
    overflow: hidden;
    background: rgba(var(--fg-rgb), 0.15);
    position: relative;
  }
  .hero__scrollcue-bead {
    position: absolute;
    inset: 0;
    background: var(--fg);
    animation: scrollcue 2s cubic-bezier(0.7, 0, 0.3, 1) infinite;
  }

  /* Los 3 bloques de .hero__topline (fecha · ubicación/reloj · rol) no caben en
     una sola fila en celular; el hero los recortaría con overflow:hidden. */
  @media (max-width: 480px) {
    .hero {
      padding: 76px 20px 20px;
    }
    .hero__topline {
      flex-wrap: wrap;
      row-gap: 6px;
      font-size: 9px;
    }
    .hero__topline-right {
      text-align: left;
    }
  }
</style>
