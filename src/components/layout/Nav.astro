---
import { navLinks, site } from "../../data/site";
---

<nav class="nav">
  <a href="#top" class="nav__brand">
    <span class="nav__dot" aria-hidden="true"></span>{site.nombre}
  </a>
  <div class="nav__links">
    {navLinks.map((link, i) => (
      <a href={link.href} class={i === navLinks.length - 1 ? "nav__contact" : undefined}>
        {link.label}
      </a>
    ))}
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 30px;
    backdrop-filter: blur(16px);
    background: rgba(12, 12, 11, 0.6);
    border-bottom: 1px solid rgba(var(--fg-rgb), 0.08);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .nav__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--fg);
    animation: blink 2.6s infinite;
  }
  .nav__links {
    display: flex;
    gap: 24px;
    white-space: nowrap;
  }
  .nav__contact {
    color: var(--accent-italic);
  }

  /* El diseño original no define breakpoints (todo depende de clamp()/auto-fit),
     pero 5 links + logo en una sola fila desbordan cualquier viewport de celular. */
  @media (max-width: 640px) {
    .nav {
      flex-wrap: wrap;
      row-gap: 10px;
      padding: 14px 20px;
    }
    .nav__links {
      gap: 12px 16px;
      flex-wrap: wrap;
      font-size: 9.5px;
    }
  }
</style>
